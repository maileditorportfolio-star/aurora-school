# Server
PORT=4000
NODE_ENV=development

# Database (MySQL / MariaDB)
DATABASE_URL="mysql://root:@localhost:3306/aurora_school"

# Auth — CHANGE THIS to a long random string
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Security
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT=20

# Client
CLIENT_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Logging (trace, debug, info, warn, error, fatal)
LOG_LEVEL=debug

# Demo seed password (development only — change in production)
SEED_DEMO_PASSWORD=aurora123

# Error tracking (optional — leave SENTRY_DSN empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
